# DB 접속 정보 (메인: Supabase / 백업: 로컬 backup-db)
# 1. 이 파일을 같은 폴더에 복사해서 이름을 .env 로 바꾸세요.
# 2. 아래 값을 채우세요. 값은 팀 담당자에게 받습니다.
#    (Supabase 대시보드 → Connect → "Session pooler" 접속 정보)
# .env 파일은 Git에 올라가지 않습니다. 절대 커밋하거나 채팅방에 공개로 올리지 마세요.

# 메인 DB (Supabase). 평소에는 이쪽을 씁니다.
PRIMARY_DB_URL=jdbc:postgresql://호스트주소:5432/postgres?sslmode=require
PRIMARY_DB_USERNAME=postgres.프로젝트ID
PRIMARY_DB_PASSWORD=비밀번호

# 백업 DB (로컬 backup-db, infra/server 참고). Supabase 장애 시 자동으로 전환됩니다.
BACKUP_DB_URL=jdbc:postgresql://localhost:5433/wattever
BACKUP_DB_USERNAME=postgres
BACKUP_DB_PASSWORD=wattever

# 자동 전환 기능 사용 여부 (이 줄이 없으면 서버 기본값 true로 켜짐)
# 로컬에 backup-db(Docker)를 안 띄워 두면, 전환되는 순간 쿼리가 다 실패합니다.
# backup-db를 안 띄우는 PC에서는 false로 꺼두세요. (DB 전환 기능 자체를 작업/테스트할 때만 true + backup-db 실행)
FAILOVER_ENABLED=false

# 시뮬레이터 실행 여부 (기본 false)
# 팀 공용 DB라서 시뮬레이터 담당자 1명만 true 로 바꿉니다. 나머지는 false 그대로 두세요.
SIMULATOR_ENABLED=false

# AI 서버(FastAPI, 공장 부하 예측) 주소 (기본 http://localhost:8000)
# 로컬에서 띄우기: cd ai && python -m uvicorn app.main:app --port 8000
# 서버가 꺼져 있으면 판단 엔진은 최근 1시간 평균 부하로 대신 계획합니다.
# AI_SERVER_URL=http://localhost:8000
