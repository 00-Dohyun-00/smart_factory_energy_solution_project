# DB 접속 정보 (Supabase)
# 1. 이 파일을 같은 폴더에 복사해서 이름을 .env 로 바꾸세요.
# 2. 아래 값을 채우세요. 값은 팀 담당자에게 받습니다.
#    (Supabase 대시보드 → Connect → "Session pooler" 접속 정보)
# .env 파일은 Git에 올라가지 않습니다. 절대 커밋하거나 채팅방에 공개로 올리지 마세요.

DB_URL=jdbc:postgresql://호스트주소:5432/postgres?sslmode=require
DB_USERNAME=postgres.프로젝트ID
DB_PASSWORD=비밀번호

# 시뮬레이터 실행 여부 (기본 false)
# 팀 공용 DB라서 시뮬레이터 담당자 1명만 true 로 바꿉니다. 나머지는 false 그대로 두세요.
SIMULATOR_ENABLED=false
